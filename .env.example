# ─────────────────────────────────────────────────────────────
# Firebase — required. Copy this file to `.env` and fill in the
# values from Firebase Console → Project settings → Your apps.
# Restart `npm run dev` after editing.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# EmailJS — optional. Leave blank to disable status emails; the
# portal will silently skip sending instead of erroring.
# https://dashboard.emailjs.com/
# ─────────────────────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_APPROVED=
VITE_EMAILJS_TEMPLATE_REJECTED=
